{
  "name": "computer-use-win-opencv-mcp",
  "version": "0.1.0",
  "description": "Hybrid Windows computer-use MCP server with UI Automation, OpenCV, OCR, and optional vision-model grounding.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "computer-use-win-opencv-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/index.js --transport stdio",
    "start:http": "node ./dist/index.js --transport http",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@screen-capture/node": "1.1.0",
    "@techstark/opencv-js": "5.0.0-release.1",
    "dotenv": "17.4.2",
    "express": "4.21.2",
    "sharp": "0.35.4",
    "tesseract.js": "7.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "4.17.23",
    "@types/node": "24.5.2",
    "tsup": "8.5.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "win32"
  ],
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mlnima/computer-use-win-opencv-mcp.git"
  },
  "keywords": [
    "mcp",
    "windows",
    "computer-use",
    "opencv",
    "ocr",
    "uiautomation"
  ]
}
